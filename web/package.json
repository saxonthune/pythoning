{
  "name": "python-interview-prep-web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:state": "node --experimental-strip-types --test tests/protected-code.test.mjs",
    "test:catalog": "node --test tests/catalog.test.mjs",
    "test:editor": "playwright test --project=editor",
    "test:execution": "playwright test --project=execution",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/theme-one-dark": "^6.1.2",
    "astro": "^7.3.2",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
