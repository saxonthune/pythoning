---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import Microgames from '../components/Microgames.astro';
import Footer from '../components/Footer.astro';
import { THEME_INIT } from '../lib/theme.ts';
import { problems, idToSlug } from '../lib/problems.ts';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const firstExercise = problems.find((p) => p.id === '00-foundations/01-data-class-product');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Daily Practice · Pythoning</title>
    <script is:inline set:html={THEME_INIT}></script>
  </head>
  <body>
    <main>
      <SiteHeader selected="microgames" />

      <section class="intro">
        <p class="duration">A short session · about 15 minutes</p>
        <h1>Get your coding reflexes back.</h1>
        <p class="summary">Practice the small moves interviews assume you can do: model a problem, write working Python, and explain your choices out loud.</p>
      </section>

      <Microgames />

      <section class="session" aria-labelledby="today-heading">
        <div class="session-head">
          <div>
            <p class="day-label">Today’s practice</p>
            <h2 id="today-heading">Make a data class and use it</h2>
          </div>
          <span class="level">Starting point</span>
        </div>

        <p class="prompt">You’re given a product name, its price, and a quantity. Define a <code>Product</code> data class, create products from input values, and calculate each product’s total value.</p>

        <ol class="steps">
          <li><strong>Model it</strong><span>Choose the fields and their types. What should Python generate for you?</span></li>
          <li><strong>Build it</strong><span>Write the class, make an instance, and implement <code>total_value()</code>.</span></li>
          <li><strong>Explain it</strong><span>Say how construction works and walk through one example without reading your code.</span></li>
        </ol>

        <div class="target">
          <span>Be ready to say</span>
          <p>“A data class stores related values. The decorator generates the initializer, so I can create a product with its name, price, and quantity.”</p>
        </div>

        {firstExercise && (
          <a class="start" href={`${base}problem/${idToSlug(firstExercise.id)}`}>Start the exercise</a>
        )}
      </section>

      <p class="closing">The goal is fluency under light pressure. Start with the basics, then build toward data structures, algorithms, and common design questions.</p>
      <Footer />
    </main>
  </body>
</html>

<style is:global>
  body { max-width: 820px; padding: 1rem 1.25rem; }
  .topline { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; font-size: 13px; }
  .topline a { color: var(--muted); }
  .site-tabs { display: flex; gap: 1.25rem; margin-bottom: 2.4rem; border-bottom: 1px solid var(--border); }
  .site-tabs a { color: var(--muted); text-decoration: none; padding: .65rem .15rem; font-size: 14px; }
  .site-tabs a[aria-current="page"] { color: var(--text); border-bottom: 2px solid var(--accent); }
  .intro { max-width: 650px; margin-bottom: 2rem; }
  .duration, .day-label { color: var(--accent); font-size: 13px; margin: 0 0 .65rem; }
  h1 { font-size: clamp(30px, 6vw, 42px); line-height: 1.08; letter-spacing: -.035em; max-width: 580px; margin: 0; }
  .summary { max-width: 600px; color: var(--muted); line-height: 1.65; font-size: 16px; margin: 1rem 0 0; }
  .session { background: var(--desc-bg); border: 1px solid var(--border); border-radius: 8px; padding: clamp(1.1rem, 4vw, 2rem); }
  .session-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  h2 { font-size: 21px; margin: 0; }
  .level { color: var(--muted); font-size: 12px; border: 1px solid var(--border); border-radius: 99px; padding: .3rem .65rem; white-space: nowrap; }
  .prompt { font-size: 15px; line-height: 1.65; margin: 1.35rem 0 1.5rem; max-width: 620px; }
  code { font-family: var(--mono, ui-monospace, monospace); font-size: .92em; }
  .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .steps li { display: grid; grid-template-columns: 110px 1fr; gap: 1rem; padding: .9rem 0; border-bottom: 1px solid var(--border); line-height: 1.5; font-size: 14px; }
  .steps li span { color: var(--muted); }
  .target { border-left: 3px solid var(--accent); padding: .15rem 0 .15rem 1rem; margin: 1.5rem 0; }
  .target > span { font-size: 12px; color: var(--muted); }
  .target p { margin: .4rem 0 0; line-height: 1.55; font-size: 14px; }
  .start { display: inline-block; background: var(--accent); color: var(--button-text, white); padding: .7rem 1rem; border-radius: 5px; text-decoration: none; font-size: 14px; font-weight: 600; }
  .start:hover { filter: brightness(1.08); }
  .closing { max-width: 600px; margin: 1.6rem 0 2.5rem; color: var(--muted); font-size: 14px; line-height: 1.6; }
  @media (max-width: 520px) { .steps li { grid-template-columns: 1fr; gap: .2rem; } .session-head { flex-direction: column; } }
</style>
