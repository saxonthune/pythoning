---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import ProblemList from '../components/ProblemList.astro';
import Footer from '../components/Footer.astro';
import { problems, idToSlug } from '../lib/problems.ts';
import { THEME_INIT } from '../lib/theme.ts';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const slugs = problems.map((p) => idToSlug(p.id));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pythoning</title>
    <script is:inline set:html={THEME_INIT}></script>
  </head>
  <body>
    <main>
      <SiteHeader selected="problems" />
      <article class="problem-article">
        <div class="list-actions">
          <p class="sub">{problems.length} Problems</p>
          <button id="random" class="btn-primary">Random</button>
          <a href="#" id="clear-all" class="muted-link">Clear Saved</a>
        </div>

      <ProblemList />
      </article>
      <Footer />
    </main>

    <script define:vars={{ base, slugs }}>
      const btn = document.getElementById('random');
      btn?.addEventListener('click', () => {
        const slug = slugs[Math.floor(Math.random() * slugs.length)];
        location.href = `${base}problem/${slug}`;
      });
      const clear = document.getElementById('clear-all');
      clear?.addEventListener('click', (e) => {
        e.preventDefault();
        if (!confirm('Clear all saved solutions from this browser?')) return;
        const keys = [];
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && (k.startsWith('solution:') || k.startsWith('skeleton_hash:'))) keys.push(k);
        }
        keys.forEach((k) => localStorage.removeItem(k));
        alert(`Cleared ${keys.length} entries.`);
      });
    </script>

    <style is:global>body { max-width: 1000px; padding: 1.5rem; }</style>
    <style>
      .problem-article { background: var(--article-bg); border: var(--outer-border-width) solid var(--outer-border); border-radius: 16px; padding: clamp(1rem, 3vw, 2rem); }
      .list-actions { display: flex; gap: .75rem; align-items: center; margin-bottom: 1.5rem; }
      .sub { margin: 0 auto 0 0; color: var(--muted); font-size: 13px; }
    </style>
  </body>
</html>
